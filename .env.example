# Never commit real values. Copy this file to .env for local development.

# Telegram: token from @BotFather and numeric IDs allowed to use the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789

# Speech recognition and copy generation.
REELBOT_OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4o-mini

# Instagram Graph API. The account must be Creator/Business and linked to Facebook.
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_API_VERSION=v22.0

# Public HTTPS origin from which Meta can temporarily fetch approved media.
# Example: https://reelbot.example.com (no trailing slash)
PUBLIC_BASE_URL=

# Persistent local state.
DATA_DIR=./data
DATABASE_PATH=./data/reelbot.sqlite3
MEDIA_ROOT=./data/media

# Service and media limits.
HOST=0.0.0.0
PORT=8000
MAX_TELEGRAM_UPLOAD_MB=20
MAX_PREVIEW_MB=49
MAX_DRIVE_DOWNLOAD_MB=500
DRIVE_DOWNLOAD_TIMEOUT_SECONDS=900
MEDIA_COMMAND_TIMEOUT_SECONDS=900
PUBLIC_MEDIA_TTL_HOURS=72
MEDIA_RETENTION_DAYS=30
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
VIDEO_CRF=20
LOG_LEVEL=INFO

